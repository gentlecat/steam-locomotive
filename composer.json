{
    "name": "tsukanov/steam-locomotive",
    "type": "library",
    "description": "PHP wrapper for Steam Web API with some useful tools",
    "license": "Apache-2.0",
    "homepage": "https://github.com/Tsukanov/steam-locomotive/",
    "keywords": [
        "steam",
        "valve",
        "dota",
        "tf2"
    ],
    "authors": [
        {
            "name": "Roman Tsukanov",
            "email": "roman@tsukanov.me",
            "homepage": "http://tsukanov.me/"
        },
        {
            "name": "Steam Locomotive Community",
            "homepage": "https://github.com/tsukanov/steam-locomotive/graphs/contributors"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Tsukanov\\SteamLocomotive\\": "src/Tsukanov/SteamLocomotive/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tsukanov\\SteamLocomotive\\Tests\\": "tests/Tsukanov/SteamLocomotive/Tests/"
        }
    }
}
